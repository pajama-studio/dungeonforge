node_modules/
dist/
rust/**/target/
artifacts/
# Raw Tripo generations: ~45MB per model before decimation. Neither these nor
# the decimated tiers they produce are versioned here — see below.
tripo-out/
.tripo/
.img2threejs/
scripts/__pycache__/
.DS_Store

# Shipped models live on the studio shelf (props.pajama.studio), not in git.
# They are content-addressed there, so src/asset-urls.json — which IS versioned —
# pins the exact bytes this build loads. `npm run assets:pull` caches them back
# here for offline work; that cache is disposable.
#
# The two exceptions are third-party: KayKit's CC0 skeleton is credited in
# LICENSES.md and stays with its attribution rather than being redistributed
# from a shelf labelled studio-internal.
public/assets/**/*.glb
!public/assets/skeleton.glb
!public/assets/skeleton-game.glb
